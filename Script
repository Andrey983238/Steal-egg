-- ==========================================
-- Вкладка 2: Авто-кража (с реальными зонами)
-- ==========================================
local StealTab = Window:CreateTab("Авто-кража", 4483362458)
StealTab:CreateSection("Настройки кражи")

-- Выбор зоны (биома) — названия из реальной игры [citation:2][citation:11]
local BiomeDropdown = StealTab:CreateDropdown({
   Name = "Биом для кражи",
   Options = {"Все", "Forest", "Lake", "Desert", "Jungle", "Snow", "Volcano", "Abyss Ocean", "Prehistoric", "Cosmic", "Cherry Blossom", "Titan Temple"},
   CurrentOption = {"Все"},
   MultipleOptions = false,
   Flag = "BiomeSelect",
   Callback = function(option)
       getgenv().Config.TargetBiome = option[1]
       print("Выбран биом:", getgenv().Config.TargetBiome)
   end,
})

-- Старт авто-кражи
StealTab:CreateToggle({
   Name = "Авто-кража (вкл/выкл)",
   CurrentValue = false,
   Flag = "AutoStealToggle",
   Callback = function(Value)
       getgenv().Config.AutoStealEnabled = Value
       if Value then
           print("Авто-кража запущена. Цель:", getgenv().Config.TargetBiome)
           task.spawn(function()
               while getgenv().Config.AutoStealEnabled do
                   local char = LocalPlayer.Character
                   if char and char:FindFirstChild("HumanoidRootPart") then
                       -- Поиск яиц в Workspace (объекты обычно содержат "Egg" в названии)
                       local bestEgg = nil
                       for _, obj in ipairs(workspace:GetDescendants()) do
                           if obj:IsA("Model") and (obj.Name:lower():find("egg") or obj.Name:lower():find("nest")) then
                               -- Фильтр по биому (упрощённо: проверяем позицию или родителя)
                               -- В идеале нужно найти реальные папки биомов в Workspace
                               if getgenv().Config.TargetBiome == "Все" or obj.Parent.Name:find(getgenv().Config.TargetBiome) then
                                   bestEgg = obj
                                   break
                               end
                           end
                       end
                       
                       if bestEgg then
                           -- Телепорт к яйцу
                           local hrp = char.HumanoidRootPart
                           hrp.CFrame = bestEgg:GetPivot() + Vector3.new(0, 3, 0)
                           task.wait(0.3)
                           
                           -- Попытка взаимодействия (кражи)
                           -- В игре часто используется ProximityPrompt или нажатие E
                           local prompt = bestEgg:FindFirstChildWhichIsA("ProximityPrompt", true)
                           if prompt then
                               fireproximityprompt(prompt)
                               print("Кража выполнена")
                           end
                           task.wait(0.5)
                           
                           -- Возврат на базу (примерные координаты, нужно уточнить в игре)
                           -- Можно использовать кнопку "ТП на Спавн" ниже
                       end
                   end
                   task.wait(1)
               end
           end)
       else
           print("Авто-кража остановлена")
       end
   end,
})

