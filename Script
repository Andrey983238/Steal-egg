   CurrentValue = false,
   Flag = "SpeedToggle",
   Callback = function(Value)
       getgenv().SpeedEnabled = Value
   end,
})

MoveTab:CreateToggle({
   Name = "Античит (снять одежду)",
   CurrentValue = false,
   Flag = "AntiCheatToggle",
   Callback = function(Value)
       if Value then
           local char = LocalPlayer.Character
           if char then
               for _, v in ipairs(char:GetChildren()) do
                   if v:IsA("Accessory") or v:IsA("Shirt") or v:IsA("Pants") then
                       v:Destroy()
                   end
               end
               print("Одежда снята")
           end
       end
   end,
})

-- ==========================================
-- Вкладка 3: ТП и ESP
-- ==========================================
local VisualTab = Window:CreateTab("ТП / ESP", 4483362458)
VisualTab:CreateSection("Телепорты")

-- ТП на спавн (нужно узнать точные координаты или найти объект Spawn)
VisualTab:CreateButton({
   Name = "Телепорт на Спавн",
   Callback = function()
       local char = LocalPlayer.Character
       if char and char:FindFirstChild("HumanoidRootPart") then
           -- Пытаемся найти реальный спавн в Workspace
           local spawnPart = workspace:FindFirstChild("SpawnLocation") 
               or workspace:FindFirstChild("Spawn")
               or workspace:FindFirstChild("Base")
           
           if spawnPart and spawnPart:IsA("BasePart") then
               char.HumanoidRootPart.CFrame = spawnPart.CFrame + Vector3.new(0, 5, 0)
               print("Телепорт на спавн выполнен")
           else
               -- Если спавн не найден, пробуем использовать стандартный
               LocalPlayer:LoadCharacter() -- Принудительный респавн
               print("Спавн не найден, выполнен респавн")
           end
       end
   end,
})

VisualTab:CreateSection("ESP Яиц")

VisualTab:CreateToggle({
   Name = "Подсветка яиц (ESP)",
   CurrentValue = false,
   Flag = "EggESP",
   Callback = function(Value)
       getgenv().ESPEnabled = Value
       if Value then
           -- Удаляем старые подсветки
           for _, v in ipairs(workspace:GetDescendants()) do
               if v:IsA("Highlight") and v.Name == "EggHighlight" then
                   v:Destroy()
               end
           end
           -- Создаём новые
           for _, v in ipairs(workspace:GetDescendants()) do
               if v:IsA("Model") and v.Name:lower():find("egg") then
                   local highlight = Instance.new("Highlight")
                   highlight.Name = "EggHighlight"
                   highlight.Adornee = v
                   highlight.FillColor = Color3.fromRGB(255, 255, 0)
                   highlight.OutlineColor = Color3.fromRGB(255, 0, 0)
                   highlight.Parent = v
               end
           end
           print("ESP яиц включен")
       else
           for _, v in ipairs(workspace:GetDescendants()) do
               if v:IsA("Highlight") and v.Name == "EggHighlight" then
                   v:Destroy()
               end
           end
           print("ESP яиц выключен")
       end
   end,
})
