-- Вкладка 3: ТП и ESP
-- ==========================================
local VisualTab = Window:CreateTab("ТП / ESP", 4483362458)
VisualTab:CreateSection("Телепорты")

-- Список зон для быстрого ТП (на основе реальных биомов) [citation:2]
local TeleportDropdown = VisualTab:CreateDropdown({
   Name = "Куда телепортироваться",
   Options = {"Base (Спавн)", "Forest", "Lake", "Desert", "Jungle", "Snow", "Volcano", "Abyss Ocean", "Prehistoric", "Cosmic", "Cherry Blossom", "Titan Temple"},
   CurrentOption = {"Base (Спавн)"},
   MultipleOptions = false,
   Flag = "TeleportTarget",
   Callback = function(option) end,
})

VisualTab:CreateButton({
   Name = "Телепорт",
   Callback = function()
       local char = LocalPlayer.Character
       if char and char:FindFirstChild("HumanoidRootPart") then
           -- Для Базы: используем респавн или поиск SpawnLocation
           local target = VisualTab.Flags.TeleportTarget.Value
           if target == "Base (Спавн)" then
               -- Попытка найти спавн в Workspace
               local spawnPart = workspace:FindFirstChild("SpawnLocation") or workspace:FindFirstChild("Spawn") or workspace:FindFirstChild("Base")
               if spawnPart and spawnPart:IsA("BasePart") then
                   char.HumanoidRootPart.CFrame = spawnPart.CFrame + Vector3.new(0, 5, 0)
               else
                   LocalPlayer:LoadCharacter() -- Принудительный респавн
               end
           else
               -- Для других зон: ищем папку с названием биома или ближайшее яйцо в этой зоне
               local biomeFolder = workspace:FindFirstChild(target)
               if biomeFolder and biomeFolder:IsA("BasePart") then
                   char.HumanoidRootPart.CFrame = biomeFolder.CFrame + Vector3.new(0, 5, 0)
               end
           end
           print("Телепорт выполнен")
       end
   end,
})

VisualTab:CreateSection("ESP Яиц")

VisualTab:CreateToggle({
   Name = "Подсветка яиц (ESP)",
   CurrentValue = false,
   Flag = "EggESP",
   Callback = function(Value)
       getgenv().Config.ESPEnabled = Value
       if Value then
           for _, v in ipairs(workspace:GetDescendants()) do
               if v:IsA("Highlight") and v.Name == "EggHighlight" then
                   v:Destroy()
               end
           end
           for _, v in ipairs(workspace:GetDescendants()) do
               if v:IsA("Model") and v.Name:lower():find("egg") then
                   local highlight = Instance.new("Highlight")
                   highlight.Name = "EggHighlight"
                   highlight.Adornee = v
                   highlight.FillColor = Color3.fromRGB(255, 255, 0)
                   highlight.OutlineColor = Color3.fromRGB(255, 0, 0)
                   highlight.Parent = v
               end
           end
           print("ESP яиц включен")
       else
           for _, v in ipairs(workspace:GetDescendants()) do
               if v:IsA("Highlight") and v.Name == "EggHighlight" then
                   v:Destroy()
               end
           end
           print("ESP яиц выключен")
       end
   end,
})
