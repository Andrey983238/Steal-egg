local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

print("=== РАЗВЕДКА STEAL AN EGG ===")

-- 1. Поиск RemoteEvent, связанных с яйцами или кражей
print("\n[RemoteEvents / RemoteFunctions]")
for _, v in ipairs(game:GetDescendants()) do
    if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") then
        local name = v.Name:lower()
        if name:find("egg") or name:find("steal") or name:find("speed") or name:find("treadmill") then
            print("  -", v:GetFullName(), "| Тип:", v.ClassName)
        end
    end
end

-- 2. Поиск объектов с "Egg" в названии
