for _, v in ipairs(workspace:GetDescendants()) do
    if v.Name:lower():find("egg") and eggCount < 20 then
        print("  -", v:GetFullName(), "| Класс:", v.ClassName, "| Родитель:", v.Parent and v.Parent.Name)
        eggCount = eggCount + 1
    end
end
if eggCount == 0 then print("  (не найдено — возможно, яйца создаются динамически)") end

-- 3. Поиск объектов, связанных со скоростью
print("\n[Объекты со 'Speed' в названии]")
for _, v in ipairs(game:GetDescendants()) do
    if v.Name:lower():find("speed") then
        print("  -", v:GetFullName(), "| Класс:", v.ClassName)
    end
end

-- 4. Проверка атрибутов персонажа (там может быть "Скорость")
print("\n[Атрибуты Humanoid]")
local char = LocalPlayer.Character
if char and char:FindFirstChild("Humanoid") then
    for attrName, attrValue in pairs(char.Humanoid:GetAttributes()) do
        print("  -", attrName, "=", attrValue)
    end
end

-- 5. Атрибуты игрока (скорость часто хранится здесь)
print("\n[Атрибуты LocalPlayer]")
for attrName, attrValue in pairs(LocalPlayer:GetAttributes()) do
    print("  -", attrName, "=", attrValue)
end

-- 6. Атрибуты лидерстата (там может быть "Speed")
print("\n[Leaderstats]")
local ls = LocalPlayer:FindFirstChild("leaderstats")
if ls then
    for _, v in ipairs(ls:GetChildren()) do
        print("  -", v.Name, "=", v.Value)
    end
else
    print("  (leaderstats не найден)")
end

