-- Steal An Egg | Script for Xeno/Delta/Volt (Keyless)
-- Загрузка UI
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "Steal An Egg | Working Script",
   LoadingTitle = "Загрузка...",
   LoadingSubtitle = "Fixed for real game",
   ConfigurationSaving = { Enabled = false },
   KeySystem = false,
})

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- Хранилище настроек
getgenv().Config = {
    SpeedEnabled = false,
    SpeedValue = 16,
    ESPEnabled = false,
    AutoStealEnabled = false,
    TargetBiome = "Все",
}

-- ==========================================
-- 1. ЦИКЛ УДЕРЖАНИЯ СКОРОСТИ (обход простого сброса)
-- ==========================================
task.spawn(function()
    while task.wait(0.05) do
        if getgenv().Config.SpeedEnabled then
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("Humanoid") then
                char.Humanoid.WalkSpeed = getgenv().Config.SpeedValue
            end
        end
    end
end)

