-- Загрузка Rayfield
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "Steal An Egg | Fixed Script",
   LoadingTitle = "Загрузка...",
   LoadingSubtitle = "by Assistant",
   ConfigurationSaving = { Enabled = false },
   KeySystem = false,
})

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- Хранилище для управления
getgenv().SpeedEnabled = false
getgenv().SpeedValue = 16
getgenv().ESPEnabled = false
getgenv().AutoStealEnabled = false
getgenv().TargetZone = "Все"

-- ==========================================
-- ЦИКЛ УДЕРЖАНИЯ СКОРОСТИ (обход базового сброса)
-- ==========================================
task.spawn(function()
    while task.wait(0.1) do
        if getgenv().SpeedEnabled then
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("Humanoid") then
                char.Humanoid.WalkSpeed = getgenv().SpeedValue
            end
        end
    end
end)

-- ==========================================
-- Вкладка 1: Авто-кража
-- ==========================================
local StealTab = Window:CreateTab("Авто-кража", 4483362458)
StealTab:CreateSection("Настройки кражи")

-- Зоны в игре (примерные названия, нужно проверить в самой игре)
local TargetDropdown = StealTab:CreateDropdown({
   Name = "Зона для кражи",
   Options = {"Все", "Cosmic", "Prehistoric", "Cherry Blossom", "Titan Temple", "Forest"},
   CurrentOption = {"Все"},
   MultipleOptions = false,
   Flag = "TargetZone",
   Callback = function(option)
       getgenv().TargetZone = option[1]
       print("Выбрана зона:", getgenv().TargetZone)
   end,
})

StealTab:CreateToggle({
   Name = "Авто-кража (вкл/выкл)",
   CurrentValue = false,
   Flag = "AutoStealToggle",
   Callback = function(Value)
       getgenv().AutoStealEnabled = Value
       if Value then
           print("Авто-кража активирована")
           -- Запуск цикла авто-кражи
           task.spawn(function()
               while getgenv().AutoStealEnabled do
                   -- Логика: найти яйцо в выбранной зоне, телепортироваться к нему, украсть, вернуться
                   -- Это упрощённая логика. На практике нужно искать ProximityPrompt у яиц.
                   local char = LocalPlayer.Character
                   if char and char:FindFirstChild("HumanoidRootPart") then
                       -- Пример: поиск всех яиц (нужно уточнить названия объектов)
                       for _, obj in ipairs(workspace:GetDescendants()) do
                           if obj.Name:lower():find("egg") and obj:IsA("Model") then
                               -- Проверка зоны (упрощённо)
                               -- Телепорт к яйцу
                               local hrp = char.HumanoidRootPart
                               hrp.CFrame = obj:GetPivot() + Vector3.new(0, 3, 0)
                               task.wait(0.5)
                               -- Попытка взаимодействия (нажать E или вызвать Remote)
                               -- Нужно найти правильный способ кражи в игре
                               break
                           end
                       end
                   end
                   task.wait(1)
               end
           end)
       else
           print("Авто-кража остановлена")
       end
   end,
})

